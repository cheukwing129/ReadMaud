          "explanation": "敗壞到不可收拾。"
        },
        {
          "term": "已矣",
          "explanation": "完了、無可挽回。"
        },
        {
          "term": "復",
          "explanation": "又。"
        },
        {
          "term": "輕身",
          "explanation": "不珍惜自己的性命。"
        },
        {
          "term": "昧",
          "explanation": "不明白。"
        },
        {
          "term": "支拄",
          "explanation": "支撐、支持。"
        },
        {
          "term": "速",
          "explanation": "趕快。"
        },
        {
          "term": "俟",
          "explanation": "等待。"
        },
        {
          "term": "搆陷",
          "explanation": "設計陷害。"
        },
        {
          "term": "即",
          "explanation": "立即。"
        },
        {
          "term": "撲殺",
          "explanation": "擊打至死。"
        }
      ]
