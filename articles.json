{
  "articles": [
    {
      "id": "article-01",
      "order": 1,
      "title": "陋室銘",
      "author": "劉禹錫",
      "category": "古典散文",
      "intro": "作者借簡陋居室抒寫安貧樂道的志趣。讀時留意文章怎樣由環境、交友和日常生活，逐步寫出「陋室不陋」。",
      "sourceUrl": "https://sites.google.com/qmss.edu.hk/chinesearticleperweek/%E9%A6%96%E9%A0%81/%E4%B9%9D%E6%9C%88/%E7%AC%AC1%E5%91%A8%E5%8A%89%E7%A6%B9%E9%8C%AB%E9%99%8B%E5%AE%A4%E9%8A%98",
      "paragraphs": [
        {
          "text": "山不在高，有仙則名。水不在深，有龍則靈。",
          "translation": "山不在於高，有仙人居住就有盛名；水不在於深，有蛟龍潛藏就顯示神靈。",
          "summary": "山水的價值不在外在大小，而在其中是否有仙、龍。",
          "analysis": "以山、水作比，提出「環境的價值由內在精神決定」；也替下文寫居室作鋪墊。",
          "notes": [
            {
              "term": "在",
              "explanation": "動詞，意思是「在於」。這裏指出山水是否高深並非關鍵，價值取決於其中有沒有仙人、蛟龍。"
            },
            {
              "term": "名",
              "explanation": "名詞活用作動詞，指「有名、著名」。"
            },
            {
              "term": "靈",
              "explanation": "形容詞活用作動詞，指「顯得靈異、有靈氣」。「有龍則靈」與「有仙則名」句式相對。"
            }
          ]
        },
        {
          "text": "斯是陋室，惟吾德馨。",
          "translation": "這雖然是間簡陋的小屋，但我品德高尚、德行美好。",
          "summary": "居室雖然簡陋，作者認為自己的品德使居所充滿美好氣息。",
          "analysis": "全文主旨句。「陋」與「馨」形成對照，說明居室的高雅不靠華麗裝潢，而由居住者的品德決定。",
          "notes": [
            {
              "term": "斯",
              "explanation": "指示代詞，意思是「這」，指作者所居的陋室。"
            },
            {
              "term": "惟",
              "explanation": "副詞，意思是「只、唯獨」，把焦點由居室轉到居住者。"
            },
            {
              "term": "德馨",
              "explanation": "「馨」本指香氣遠播，這裏比喻品德高尚。「德馨」是全篇立意所在。"
            }
          ]
        },
        {
          "text": "苔痕上階綠，草色入簾青。",
          "translation": "苔痕佈滿階石，一片翠綠；草色映入簾櫳，滿室蔥青。",
          "summary": "青苔爬上石階，青草的顏色映入簾內，居室與自然相連。",
          "analysis": "以「綠」「青」寫清幽生機；「上」「入」使景物帶有動態，呈現不經修飾的自然之美。",
          "notes": [
            {
              "term": "上",
              "explanation": "名詞活用作動詞，意思是「爬上、長上」。寫出青苔沿石階生長的動態。"
            },
            {
              "term": "綠",
              "explanation": "形容詞作動詞用，指呈現綠色；承接「苔痕上階」，寫出青苔沿石階蔓生。"
            },
            {
              "term": "青",
              "explanation": "形容詞作動詞用，指呈現青色；與「綠」相對，寫出草色映入簾內的清幽景象。"
            },
            {
              "term": "入",
              "explanation": "動詞，指草色映入簾內，呈現景物由室外延伸至室內的感覺。"
            }
          ]
        },
        {
          "text": "談笑有鴻儒，往來無白丁。",
          "translation": "往來談笑的都是博學多識之士，沒有淺薄無識之人。",
          "summary": "來訪和交談的都是有學問、有修養的人。",
          "analysis": "「鴻儒」與「白丁」對舉，凸顯作者重視精神交流和學識修養，也寫出生活圈子的清雅。",
          "notes": [
            {
              "term": "鴻儒",
              "explanation": "「鴻」有大之意；「鴻儒」指博學之士。"
            },
            {
              "term": "白丁",
              "explanation": "原指平民，亦可指沒有功名或學識的人；此處與「鴻儒」對舉，突出交往者的學養。"
            },
            {
              "term": "談笑",
              "explanation": "交談說笑，與「有鴻儒」相連，寫出作者的交遊對象。"
            },
            {
              "term": "往來",
              "explanation": "來往交遊，與「無白丁」相連，補寫陋室中的人際生活。"
            }
          ]
        },
        {
          "text": "可以調素琴，閱金經。",
          "translation": "可以彈未加彩飾的琴，可以閱讀珍貴的經典。",
          "summary": "作者在室內彈琴、讀經，享受簡樸而充實的生活。",
          "analysis": "「素琴」見樸素，「金經」見珍重；兩件日常活動表現清靜自足的精神生活。",
          "notes": [
            {
              "term": "可以",
              "explanation": "古今用法相近，指「可以用來」。承接上句，說明陋室中可做的雅事。"
            },
            {
              "term": "調",
              "explanation": "動詞，指彈奏；「調素琴」即彈奏樸素的琴。"
            },
            {
              "term": "素琴",
              "explanation": "「素」指樸素、沒有華飾；與「金經」形成簡雅而珍重的對照。"
            },
            {
              "term": "金經",
              "explanation": "指珍貴的佛經。「金」形容其珍貴，不是指金屬製成的經書。"
            }
          ]
        },
        {
          "text": "無絲竹之亂耳，無案牘之勞形。",
          "translation": "沒有嘈雜的音樂聲擾亂耳朵，也沒有官府公文使身體勞累。",
          "summary": "沒有嘈雜樂聲和繁重公務，心神與身體都不受干擾。",
          "analysis": "以「亂耳」「勞形」寫俗務造成的煩擾，反襯陋室中的清靜自在；句式整齊，讀來有節奏。",
          "notes": [
            {
              "term": "絲竹",
              "explanation": "以樂器材料「絲」（弦樂器）、「竹」（管樂器）代指音樂。"
            },
            {
              "term": "之",
              "explanation": "結構助詞，置於主謂短語「絲竹亂耳」之間，使其成為「無」所涉及的事情，可理解為沒有音樂聲擾亂耳朵。"
            },
            {
              "term": "亂耳",
              "explanation": "「亂」是使動用法，指使耳朵受到擾亂。"
            },
            {
              "term": "案牘",
              "explanation": "官府往來的文書、公務文件。"
            },
            {
              "term": "勞形",
              "explanation": "「勞」是使動用法，指使身體勞累；「形」指身體。"
            }
          ]
        },
        {
          "text": "南陽諸葛廬，西蜀子雲亭。",
          "translation": "南陽有諸葛亮的草廬，西蜀有揚雄的玄亭。",
          "summary": "以兩位古代賢者的居所，聯想到自己的陋室。",
          "analysis": "援引諸葛亮、揚雄自況，暗示居所雖簡，居者可以有高尚志趣與學問抱負。",
          "notes": [
            {
              "term": "諸葛廬",
              "explanation": "指南陽諸葛亮躬耕時的草廬。作者借賢者居所聯想到自己的陋室。"
            },
            {
              "term": "子雲亭",
              "explanation": "子雲是西漢揚雄的字；此處指揚雄在蜀地的居所玄亭。"
            },
            {
              "term": "南陽",
              "explanation": "指諸葛亮躬耕的地方，與下句「西蜀」相對。"
            },
            {
              "term": "西蜀",
              "explanation": "指揚雄的故鄉及活動地區，與上句「南陽」相對。"
            }
          ]
        },
        {
          "text": "孔子云：「何陋之有？」",
          "translation": "正如孔子說的：「有什麼簡陋之處呢？」",
          "summary": "作者借孔子的話作結：有德者居住，便沒有真正的簡陋。",
          "analysis": "以反問收束，語氣堅定有力；呼應「惟吾德馨」，再次點明精神品格比物質環境更重要。",
          "notes": [
            {
              "term": "云",
              "explanation": "動詞，意思是「說」。孔子云即孔子說。"
            },
            {
              "term": "何陋之有",
              "explanation": "「何陋」是「有」的賓語；「之」是賓語前置的標誌，按一般語序即「有何陋」。整句反問「有甚麼簡陋呢？」；「何」是疑問代詞，這裏並非真要詢問，而是強調陋室不陋。"
            }
          ]
        }
      ],
      "type": "classical"
    },
